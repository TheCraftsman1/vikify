# Server-only configuration. Never copy NVIDIA_API_KEY into the Android project.
DEV_MODE=false
CORS_ORIGINS=[]
LLM_PROVIDER=nvidia
# Existing Nemotron Lightning model: 30B total parameters, 3B active per token.
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
LLM_TIMEOUT_SEC=5
# Use this deployment's legitimate Firebase project and server credentials.
# FIREBASE_PROJECT_ID=your-existing-firebase-project
# FIREBASE_SERVICE_ACCOUNT=C:/secure/path/firebase-service-account.json
